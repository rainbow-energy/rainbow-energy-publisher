interval: 5.0
# Optional; default is INFO (DEBUG, WARNING, ERROR, …)
# log_level: DEBUG
profile: sunsynk_8k_sg05lp1
# Or use a custom map on disk:
# profile_path: /maps/my_inverter.yaml
keys:
  - battery_soc
  - battery_voltage
  - battery_power
  - pv_power
  - load_power
  - grid_power
# Or poll every readable register from the profile (quote required in YAML):
# keys: "*"

modbus:
  device_id: 1
  tcp:
    host: modbus-gateway.example
    port: 502
  # usb:
  #   port: /dev/ttyUSB0

mqtt:
  host: mqtt.example
  # port: 1883
  topic_prefix: rainbow/energy
  # retain: true
  # device_id: inverter-1
  # ha_discovery: false
  # discovery_prefix: homeassistant
  # Optional auth; MQTT_USERNAME / MQTT_PASSWORD env vars override these
  # username: homeassistant
  # password: change-me
